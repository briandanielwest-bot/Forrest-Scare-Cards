# ---- Required ----
# Your Anthropic API key. Every agent call goes through this.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Storage ----
# Render wires this automatically from the Blueprint. Without it the API
# runs on an in-memory store: fine for `npm run dev`, loses every book on
# restart. Never run production without it.
DATABASE_URL=postgres://user:pass@localhost:5432/storykeep

# ---- Auth ----
# Signs the session cookie. Generate with: openssl rand -hex 32
# If unset, the server generates a random one at boot, which logs
# everybody out on every deploy. Set it.
SESSION_SECRET=

# ---- Models ----
# The prose, structure and craft agents. Do not downgrade without measuring:
# prose quality is the product.
ANTHROPIC_MODEL=claude-opus-5
# The extraction / bookkeeping agents (Listener, Continuity, Originality).
ANTHROPIC_FAST_MODEL=claude-sonnet-5

# ---- Money guards ----
# Hard daily ceiling on Claude API spend, in USD. Unset = no limit, which is
# correct locally and wrong for a public link. Measured cost per finished
# memoir chapter is roughly $0.30-$0.70; $25/day covers a real launch week.
DAILY_LIMIT_USD=25
# Per-user monthly ceiling, USD. Stops one enthusiastic author from
# consuming the whole budget.
USER_MONTHLY_LIMIT_USD=12

# ---- Voice ----
# Optional. With a key, uploaded audio is transcribed server-side (better
# accuracy, works on every browser). Without one, the app falls back to the
# browser's own speech recognition and still works.
DEEPGRAM_API_KEY=

# ---- Illustration ----
# Optional. Claude writes the art direction; this renders it. Without a key
# the app still produces the full illustration brief per spread, and shows
# it as a placeholder card the customer can hand to any illustrator.
IMAGE_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# ---- Payments ----
# Optional in development. Exports are free when Stripe is not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Wiring ----
CORS_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PORT=4000
