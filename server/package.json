{
  "name": "bayou-blazer-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Bayou & Blazer — the Houston high-end menswear planning app. Runs the agent pipeline (Interviewer, Photo Analyst, Houston Store Scouts, Style & Weather, Wardrobe Planner) on top of the Claude API.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "refresh:data": "ts-node --transpile-only scripts/refresh-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
