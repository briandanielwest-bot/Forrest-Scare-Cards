# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides
PORT=4000
# The wardrobe planner (budget math + final synthesis) runs on this model.
ANTHROPIC_MODEL=claude-opus-5
# Everything else (interviewer, photo analyst, scouts) runs on this faster
# model - speed is the feature for those agents.
ANTHROPIC_FAST_MODEL=claude-sonnet-5
CORS_ORIGIN=*

# Only set this if you get the error "anthropic-workspace-id is required
# when authenticating with an identity-linked API key" — it means your key
# (a personal or service-account key) wasn't scoped to one workspace when
# created. Either re-create the key in the Console with a specific
# workspace selected (then you can leave this unset), or find your
# workspace's id (starts with wrkspc_) under Settings -> Workspaces at
# https://platform.claude.com/settings/workspaces and set it here.
# ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id
